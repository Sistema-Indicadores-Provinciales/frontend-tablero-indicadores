# Development: defaults to the browser hostname and ports 3000/8000.
# Production: defaults to /api and /analytics behind the same HTTPS domain.
VITE_APP_SERVER_URL=
VITE_APP_SERVER_PORT=3000
VITE_FASTAPI_URL=
VITE_FASTAPI_PORT=8000
VITE_GOOGLE_MAPS_API_KEY=
# Optional OAuth web client ID for private Sheets; can also be set in Administration.
# Public Sheets links do not need this setting.
VITE_GOOGLE_CLIENT_ID=
